<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminBookingCard"
    style="@style/Widget.Hotel.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <!-- Top row: booking code + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/adminBookingCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:text="BK-D48208" />

            <TextView
                android:id="@+id/adminBookingStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/badge_status_bg"
                android:text="Chờ nhận" />
        </LinearLayout>

        <!-- Room name -->
        <TextView
            android:id="@+id/adminBookingRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Deluxe Ocean Twin - Sea View" />

        <!-- Guest name (shown for admin) -->
        <TextView
            android:id="@+id/adminBookingGuest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="Khách: Nguyen Van A" />

        <!-- Check-in / Check-out dates -->
        <TextView
            android:id="@+id/adminBookingDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="Nhận: 28/04 → Trả: 01/05" />

        <!-- Overdue warning (hidden unless overdue) -->
        <TextView
            android:id="@+id/adminBookingOverdue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/danger"
            android:text="⚠ QUÁ HẠN TRẢ PHÒNG"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
